[init]
    defaultBranch = main
[core]
    editor = nvim
    # delta for diffs, log -p and show; plain less where it isn't installed
    pager = "if command -v delta >/dev/null; then delta; else less; fi"
[interactive]
    # Highlights `add -p` hunks; must keep the lines unchanged, hence --color-only
    diffFilter = "if command -v delta >/dev/null; then delta --color-only; else cat; fi"
[delta]
    # n / N jump between files in a diff
    navigate = true
    line-numbers = true
[pull]
    rebase = true
[fetch]
    prune = true
[rerere]
    enabled = true
    # Stage files once rerere has replayed a recorded resolution
    autoUpdate = true
[rebase]
    autoStash = true
[merge]
    # zdiff3 where git supports it, set in ~/.gitconfig.local by dotfiles-bootstrap
    conflictStyle = diff3
[diff]
    algorithm = histogram
    # Moved blocks get their own colours, alternating so adjacent moves are distinct
    colorMoved = zebra
[commit]
    verbose = true
[include]
    path = ~/.gitconfig.local
