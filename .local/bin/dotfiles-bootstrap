#!/usr/bin/env bash
# shellcheck disable=SC2329 # some functions only run indirectly: trap, replace_dir, update_release
set -euo pipefail

usage() {
    cat <<EOF
Usage:
  dotfiles-bootstrap                Clone (or update) the dotfiles and install or update
                                    the extras from the internet
  dotfiles-bootstrap pack [FILE]    Build an offline package of the dotfiles, nvim plugins,
                                    treesitter parsers, language servers, delta, xcape
                                    and Nerd Font
  dotfiles-bootstrap apply PATH     Install or update from an offline package, given as the
                                    .tar.gz or the extracted dotfiles-offline directory
EOF
}

DOTFILES_REPO="https://github.com/bnhlee/dotfiles.git"
DOTFILES_DIR="$HOME/.dotfiles"

NERD_FONT="JetBrainsMono"
FONT_DIR="$HOME/.local/share/fonts/${NERD_FONT}Nerd"
# Plugins (vim.pack), compiled treesitter parsers and their queries
NVIM_SITE="$HOME/.local/share/nvim/site"

# Temporary directory for pack/apply, removed on exit
STAGE=""
cleanup() {
    if [ -n "$STAGE" ]; then rm -rf "$STAGE"; fi
}
trap cleanup EXIT

# -C: git prints and takes paths relative to the work tree, wherever this runs
dotfiles() {
    git -C "$HOME" --git-dir="$DOTFILES_DIR" --work-tree="$HOME" "$@"
}

clone_dotfiles() {
    # -c: avoids git's "default branch name" hint; the branch comes from the source
    git -c init.defaultBranch=main clone --quiet --bare "$1" "$DOTFILES_DIR"
}

# A bare clone doesn't track its remote, so plain `dotfiles pull` wouldn't
# work. Only fills in what's unset.
configure_dotfiles_repo() {
    dotfiles config status.showUntrackedFiles no
    local branch
    branch=$(dotfiles symbolic-ref --short HEAD)
    dotfiles config --get remote.origin.fetch >/dev/null \
        || dotfiles config remote.origin.fetch "+refs/heads/*:refs/remotes/origin/*"
    dotfiles config --get "branch.$branch.remote" >/dev/null || {
        dotfiles config "branch.$branch.remote" origin
        dotfiles config "branch.$branch.merge" "refs/heads/$branch"
    }
}

# Fast-forward the dotfiles to the current branch from $1 (a remote, or the
# offline package's bundle). Local work is never overwritten: local commits,
# or local edits to files the update changes, leave the repo as it is with a
# warning. Untracked files in the way of newly added dotfiles are moved to
# ~/.dotfiles-backup, as on the first checkout.
update_dotfiles() {
    local src="$1" backup="$HOME/.dotfiles-backup" branch old new f
    local blocked=() moved=()
    branch=$(dotfiles symbolic-ref --short HEAD)
    if ! dotfiles fetch --quiet "$src" "$branch"; then
        echo "Warning: couldn't fetch the dotfiles; keeping the current version." >&2
        return 0
    fi
    old=$(dotfiles rev-parse HEAD)
    new=$(dotfiles rev-parse FETCH_HEAD)
    # Up to date, or only local commits on top
    if dotfiles merge-base --is-ancestor "$new" "$old"; then
        echo "Dotfiles are up to date."
        return 0
    fi
    if ! dotfiles merge-base --is-ancestor "$old" "$new"; then
        echo "Warning: local dotfiles commits have diverged from the update; not updating." \
            "Merge or rebase them yourself (dotfiles pull)." >&2
        return 0
    fi

    # Local edits, staged or not, to files the update changes. --no-renames
    # throughout: with rename detection, --name-only lists only a renamed
    # file's new path, and --diff-filter=A leaves it out.
    while IFS= read -r -d '' f; do
        blocked+=("$f")
    done < <(comm -z -12 <(dotfiles diff -z --no-renames --name-only HEAD | sort -z) \
        <(dotfiles diff -z --no-renames --name-only HEAD FETCH_HEAD | sort -z))
    if [ ${#blocked[@]} -gt 0 ]; then
        echo "Warning: not updating the dotfiles; the update changes files with local changes:" >&2
        printf '  %s\n' "${blocked[@]}" >&2
        echo "Commit or stash them (dotfiles stash), then re-run." >&2
        return 0
    fi

    # git refuses to overwrite untracked files, even identical ones
    while IFS= read -r -d '' f; do
        if [ -e "$HOME/$f" ] || [ -L "$HOME/$f" ]; then
            mkdir -p "$backup/$(dirname "$f")"
            mv "$HOME/$f" "$backup/$f"
            moved+=("$f")
        fi
    done < <(dotfiles diff -z --no-renames --name-only --diff-filter=A HEAD FETCH_HEAD)
    if [ ${#moved[@]} -gt 0 ]; then
        echo "These existing files were in the way of new dotfiles and were moved to $backup:"
        printf '  %s\n' "${moved[@]}"
    fi

    if ! dotfiles merge --ff-only --quiet FETCH_HEAD; then
        echo "Warning: couldn't update the dotfiles; keeping the current version." >&2
        # The new dotfiles didn't arrive, so put back what was moved for them
        for f in "${moved[@]}"; do
            mv "$backup/$f" "$HOME/$f"
        done
        [ ${#moved[@]} -eq 0 ] || echo "The files moved to $backup were put back." >&2
        return 0
    fi
    echo "Dotfiles updated ($(dotfiles rev-list --count "$old..$new") new commits)."
}

# Check out the bare repo into $HOME without ever deleting anything:
# - First checkout (the bare clone has no index yet): existing files that
#   differ from the dotfiles are moved to ~/.dotfiles-backup first.
# - Re-runs: local changes to tracked files are left alone.
# Either way, tracked files missing from $HOME are then written from git, so a
# re-run also repairs deleted dotfiles. Any git error stops the script before
# a file is touched (e.g. a stale ~/.dotfiles/index.lock from a crashed git).
checkout_dotfiles() {
    configure_dotfiles_repo
    local backup="$HOME/.dotfiles-backup" f
    local moved=() missing=()

    if [ ! -f "$DOTFILES_DIR/index" ]; then
        # Fill the index from HEAD without touching $HOME, so git can compare
        dotfiles read-tree HEAD
        dotfiles update-index -q --refresh || true
        while IFS= read -r -d '' f; do
            mkdir -p "$backup/$(dirname "$f")"
            mv "$HOME/$f" "$backup/$f"
            moved+=("$f")
        done < <(dotfiles diff -z --name-only --diff-filter=MT)
    fi

    while IFS= read -r -d '' f; do
        missing+=("$f")
    done < <(dotfiles diff -z --name-only --diff-filter=D)
    if [ ${#missing[@]} -gt 0 ]; then
        # Only missing paths, so nothing existing is overwritten
        dotfiles checkout-index -- "${missing[@]}"
    fi

    echo "Dotfiles checked out into $HOME."
    if [ ${#moved[@]} -gt 0 ]; then
        echo "These existing files differed from the dotfiles and were moved to $backup:"
        printf '  %s\n' "${moved[@]}"
    fi
    if [ -n "$(dotfiles diff --name-only)" ]; then
        echo "Local changes to the dotfiles were kept (see: dotfiles status)."
    fi
}

# nvim-treesitter links site/queries/<lang> into the plugin with absolute paths,
# which break when $HOME differs. Point every absolute link under the site
# directory back into it with a relative path.
fix_site_links() {
    local site="$1" link target rel
    while IFS= read -r -d '' link; do
        target=$(readlink "$link")
        case "$target" in
            */.local/share/nvim/site/*)
                rel=$(realpath -m -s --relative-to="$(dirname "$link")" "$site/${target#*/.local/share/nvim/site/}")
                ln -sfn "$rel" "$link"
                ;;
        esac
    done < <(find "$site" -type l -lname '/*' -print0)
}

# Install or update the nvim plugins, treesitter parsers and blink.cmp's fuzzy
# matcher now, instead of on the first interactive start
install_nvim_plugins() {
    if ! command -v nvim >/dev/null; then
        echo "nvim not found; plugins will install the first time it starts."
        return 0
    fi
    local tool
    for tool in cc make tree-sitter; do
        command -v "$tool" >/dev/null || echo "Warning: $tool not found; treesitter parsers or telescope-fzf-native may fail to build." >&2
    done

    echo "Installing and updating nvim plugins and treesitter parsers (can take a few minutes)..."
    local script
    script=$(mktemp --suffix=.lua)
    # First pass: init.lua installs missing plugins (vim.pack.add); this moves
    # the installed ones to the lockfile's revisions, as the dotfiles may have
    # just updated it. The second pass then starts with the new plugin code.
    cat >"$script" <<'EOF'
vim.pack.update(nil, { target = "lockfile", force = true })
-- When nvim-treesitter changes, the PackChanged hook in init.lua starts
-- :TSUpdate. Installs of the same parser wait for each other, so this also
-- waits for that one.
local ok, ts = pcall(require, "nvim-treesitter")
if ok then
    local wait_ok, err = ts.update():pwait(10 * 60 * 1000)
    if not wait_ok then
        io.stderr:write("\nTreesitter update failed: " .. tostring(err) .. "\n")
    end
end
vim.cmd("qa!")
EOF
    nvim --headless -c "luafile $script" -c 'qa!'

    cat >"$script" <<'EOF'
-- init.lua has already installed the plugins (vim.pack.add) and built fzf-native
local ok, ts = pcall(require, "plugins.treesitter")
if ok and ts.install_task then
    -- pwait() returns false on timeout instead of throwing, so nvim still quits.
    -- nvim-treesitter's log lines don't end in a newline, hence the leading \n.
    local wait_ok, err = ts.install_task:pwait(10 * 60 * 1000)
    if not wait_ok then
        io.stderr:write("\nTreesitter install failed: " .. tostring(err) .. "\n")
    end
end
-- blink.cmp's setup() downloads the binary for its release tag when the
-- installed one is missing or from another version. It writes v0.0.0 until
-- the download is verified, then the tag.
local blink_dir = vim.fn.stdpath("data") .. "/site/pack/core/opt/blink.cmp"
local tag = vim.trim(vim.system({ "git", "-C", blink_dir, "describe", "--tags", "--exact-match" }):wait().stdout or "")
local blink_ok = vim.wait(2 * 60 * 1000, function()
    local f = io.open(blink_dir .. "/target/release/version")
    if not f then return false end
    local v = f:read("*l")
    f:close()
    if tag ~= "" then return v == tag end
    return v ~= nil and v ~= "v0.0.0"
end, 500)
local parsers = #vim.fn.glob(vim.fn.stdpath("data") .. "/site/parser/*.so", false, true)
io.stdout:write(("\nInstalled %d plugins, %d treesitter parsers%s\n"):format(
    #vim.pack.get(), parsers, blink_ok and "" or "; blink.cmp fuzzy matcher download didn't finish"))
vim.cmd("qa!")
EOF
    # The second -c quits even if the script errors before its own qa!
    nvim --headless -c "luafile $script" -c 'qa!'
    rm -f "$script"
}

# Nerd Font, for the file/git icons in nvim
FONT_URL="https://github.com/ryanoasis/nerd-fonts/releases/latest/download/${NERD_FONT}.tar.xz"

download_font() {
    mkdir -p "$1"
    curl -fsSL "$FONT_URL" | tar xJ -C "$1"
}

has_font_files() {
    compgen -G "$1/*.ttf" >/dev/null
}

font_installed() {
    # Not grep -q: it exits early, and pipefail turns fc-list's SIGPIPE into a failure
    fc-list | grep "${NERD_FONT} Nerd Font" >/dev/null
}

# delta, git's pager (see .gitconfig). Installed as the release binary in
# ~/.local/bin, since distro packages lag behind or don't exist.
DELTA_RELEASES="https://github.com/dandavison/delta/releases"
DELTA_BIN="$HOME/.local/bin/delta"

# Whether a downloaded binary actually runs here (wrong arch, missing glibc or
# libraries). For delta this matters: one that's present but won't run breaks
# every paged git command, since .gitconfig only checks it exists.
bin_runs() {
    "$1" --version >/dev/null 2>&1
}

# Latest release tag of a GitHub repo, given its releases URL.
# The latest release redirects to .../tag/<tag>.
latest_tag() {
    curl -fsSI "$1/latest" | sed -n 's|^location:.*/tag/\([^[:space:]]*\).*|\1|Ip' | grep .
}

# Whether release tag $2 is newer than installed version $1 (either may start with v)
newer_version() {
    local have="${1#v}" want="${2#v}"
    [ "$have" != "$want" ] && [ "$(printf '%s\n%s\n' "$have" "$want" | sort -V | tail -1)" = "$want" ]
}

# Install a tool from its GitHub releases, or update it when there's a newer
# release: update_release NAME RELEASES_URL INSTALLED_VERSION CMD...
# INSTALLED_VERSION is empty when it isn't installed. CMD installs the release
# whose tag it gets as an extra last argument. Failures are warnings.
update_release() {
    local name="$1" releases="$2" have="$3" tag
    shift 3
    if ! tag=$(latest_tag "$releases"); then
        if [ -n "$have" ]; then
            echo "Warning: couldn't look up the latest $name release; keeping $have." >&2
        else
            echo "Warning: couldn't look up the latest $name release; skipping it." >&2
        fi
        return 0
    fi
    if [ -z "$have" ]; then
        echo "Installing $name ${tag#v}..."
    elif newer_version "$have" "$tag"; then
        echo "Updating $name $have -> ${tag#v}..."
    else
        return 0
    fi
    "$@" "$tag" || echo "Warning: couldn't install $name ${tag#v}." >&2
}

# Version of the delta at $1, empty if there's none
delta_version() {
    "$1" --version 2>/dev/null | sed -n 's/^delta //p' || true
}

# Download delta release $2 for this machine to $1
download_delta() {
    local tag="$2" tmp status=0
    tmp=$(mktemp -d)
    curl -fsSL "$DELTA_RELEASES/download/$tag/delta-$tag-$(uname -m)-unknown-linux-gnu.tar.gz" \
        | tar xz -C "$tmp" --strip-components=1 --wildcards '*/delta' \
        && bin_runs "$tmp/delta" \
        && install -D -m 755 "$tmp/delta" "$1" \
        || status=1
    rm -rf "$tmp"
    return "$status"
}

# Language servers for nvim (see ~/.config/nvim/lsp/): bash (plus shellcheck,
# which gives it its diagnostics), Lua, PowerShell and JS/TS. gopls comes from
# `go install` instead. They all live under LSP_DIR, so pack can copy the one
# directory, and are linked into ~/.local/bin.
LSP_DIR="$HOME/.local/share/lsp"
# Installed with the system npm and run by the system node (22+, which
# typescript-language-server 6 needs). TypeScript is pinned to 6: TypeScript 7
# (the native compiler) no longer ships the tsserver it wraps.
NPM_SERVERS=(bash-language-server@5 typescript-language-server@6 typescript@6)
LUA_LS_RELEASES="https://github.com/LuaLS/lua-language-server/releases"
# PowerShellEditorServices is plain PowerShell modules, so it needs nothing to
# pack. It runs on the system's pwsh, which the bootstrap doesn't install.
PSES_RELEASES="https://github.com/PowerShell/PowerShellEditorServices/releases"
SHELLCHECK_RELEASES="https://github.com/koalaman/shellcheck/releases"

# lua-language-server names its Linux builds arm64 / x64
release_arch() {
    case "$(uname -m)" in
        x86_64) echo x64 ;;
        aarch64) echo arm64 ;;
        *) uname -m ;;
    esac
}

# Replace directory $1 with what "${@:2}" puts into a new empty directory,
# passed as its last argument. $1 is left as it was if the command fails.
replace_dir() {
    local dest="$1" tmp status=0
    shift
    mkdir -p "$(dirname "$dest")" && tmp=$(mktemp -d "$dest.XXXXXX") || return 1
    if "$@" "$tmp"; then
        rm -rf "$dest" && mv -T "$tmp" "$dest" || status=1
    else
        status=1
    fi
    rm -rf "$tmp"
    return "$status"
}

npm_servers_installed() {
    local bin="$1/node/node_modules/.bin"
    [ -x "$bin/bash-language-server" ] && [ -x "$bin/typescript-language-server" ] \
        && [ -f "$1/node/node_modules/typescript/lib/tsserver.js" ]
}

# Into $1/node_modules. Pure JS (bash-language-server's parser is wasm), so
# the result runs on any architecture. .servers records the pins it used.
fetch_npm_servers() {
    # stdout is just "added N packages"; errors go to stderr
    npm install --prefix "$1" --no-fund --no-audit --loglevel=error "${NPM_SERVERS[@]}" >/dev/null \
        && echo "${NPM_SERVERS[*]}" >"$1/.servers"
}

# Whether the npm servers in $1 need (re)installing: missing, installed with
# other NPM_SERVERS pins, or with updates within their pins (npm's "wanted";
# its "latest" can be a new major, like TypeScript 7). If npm can't check,
# for example offline, they count as up to date.
npm_servers_outdated() {
    npm_servers_installed "$1" || return 0
    [ "$(cat "$1/node/.servers" 2>/dev/null)" = "${NPM_SERVERS[*]}" ] || return 0
    local outdated
    # Exits 1 when anything has a newer version, wanted or not
    outdated=$(npm outdated --prefix "$1/node" --json 2>/dev/null || true)
    printf '%s' "$outdated" | node -e '
        let json = "";
        process.stdin.on("data", (d) => (json += d)).on("end", () => {
            let pkgs = {};
            try { pkgs = JSON.parse(json); } catch {}
            const stale = Object.values(pkgs).some((p) => p && p.current && p.wanted && p.current !== p.wanted);
            process.exit(stale ? 0 : 1);
        });'
}

# Installed versions, empty when not installed
lua_ls_version() {
    "$1/bin/lua-language-server" --version 2>/dev/null || true
}

shellcheck_version() {
    "$1/shellcheck" --version 2>/dev/null | sed -n 's/^version: //p' || true
}

pses_version() {
    sed -n "s/^ *ModuleVersion *= *'\([^']*\)'.*/\1/p" \
        "$1/PowerShellEditorServices/PowerShellEditorServices.psd1" 2>/dev/null || true
}

# Release $1 into directory $2
fetch_lua_ls() {
    curl -fsSL "$LUA_LS_RELEASES/download/$1/lua-language-server-$1-linux-$(release_arch).tar.gz" \
        | tar xz -C "$2" \
        && bin_runs "$2/bin/lua-language-server"
}

# A static binary, named for uname -m
fetch_shellcheck() {
    curl -fsSL "$SHELLCHECK_RELEASES/download/$1/shellcheck-$1.linux.$(uname -m).tar.gz" \
        | tar xz -C "$2" --strip-components=1 \
        && bin_runs "$2/shellcheck"
}

fetch_pses() {
    curl -fsSL "$PSES_RELEASES/download/$1/PowerShellEditorServices.zip" -o "$2/pses.zip" \
        || return 1
    if command -v unzip >/dev/null; then
        unzip -q "$2/pses.zip" -d "$2"
    else
        python3 -m zipfile -e "$2/pses.zip" "$2"
    fi && rm "$2/pses.zip" \
        && [ -f "$2/PowerShellEditorServices/Start-EditorServices.ps1" ]
}

# Install the language servers into $1 (an LSP_DIR layout), or update them:
# the npm ones within their pinned majors, the others to their latest release.
# Failures are warnings: nvim only enables the servers it finds.
update_lsp_servers() {
    local dir="$1"
    if ! command -v npm >/dev/null; then
        npm_servers_installed "$dir" \
            || echo "Warning: npm not found; skipping the bash and JS/TS language servers." >&2
    elif npm_servers_outdated "$dir"; then
        if npm_servers_installed "$dir"; then
            echo "Updating the bash and JS/TS language servers..."
        else
            echo "Installing the bash and JS/TS language servers..."
        fi
        replace_dir "$dir/node" fetch_npm_servers \
            || echo "Warning: couldn't install the bash and JS/TS language servers." >&2
    fi
    update_release lua-language-server "$LUA_LS_RELEASES" "$(lua_ls_version "$dir/lua-language-server")" \
        replace_dir "$dir/lua-language-server" fetch_lua_ls
    update_release shellcheck "$SHELLCHECK_RELEASES" "$(shellcheck_version "$dir/shellcheck")" \
        replace_dir "$dir/shellcheck" fetch_shellcheck
    update_release PowerShellEditorServices "$PSES_RELEASES" "$(pses_version "$dir/pses")" \
        replace_dir "$dir/pses" fetch_pses
}

# Link the servers into ~/.local/bin. Files there that aren't
# symlinks are someone else's install and are left alone.
link_lsp_bins() {
    local name target link
    while read -r name target; do
        link="$HOME/.local/bin/$name"
        if [ -e "$target" ] && { [ -L "$link" ] || [ ! -e "$link" ]; }; then
            mkdir -p "$HOME/.local/bin"
            ln -sfn "$target" "$link"
        fi
    done <<EOF
bash-language-server $LSP_DIR/node/node_modules/.bin/bash-language-server
typescript-language-server $LSP_DIR/node/node_modules/.bin/typescript-language-server
lua-language-server $LSP_DIR/lua-language-server/bin/lua-language-server
shellcheck $LSP_DIR/shellcheck/shellcheck
EOF
}

# Point GNOME Terminal's default profile at the font, unless a font was already picked
set_terminal_font() {
    command -v gnome-terminal >/dev/null && command -v gsettings >/dev/null || return 0
    local profile schema
    profile=$(gsettings get org.gnome.Terminal.ProfilesList default 2>/dev/null | tr -d "'") || return 0
    [ -n "$profile" ] || return 0
    schema="org.gnome.Terminal.Legacy.Profile:/org/gnome/terminal/legacy/profiles:/:$profile/"
    if [ "$(gsettings get "$schema" use-system-font)" = "true" ]; then
        gsettings set "$schema" font "${NERD_FONT} Nerd Font 11"
        gsettings set "$schema" use-system-font false
        echo "GNOME Terminal font set to ${NERD_FONT} Nerd Font."
    fi
}

# Caps Lock as Ctrl (GNOME; Ctrl-[ then works as Esc). Other XKB options are
# kept, and an existing Caps Lock option is left alone.
set_caps_ctrl() {
    command -v gsettings >/dev/null || return 0
    local key="org.gnome.desktop.input-sources" options
    options=$(gsettings get "$key" xkb-options 2>/dev/null) || return 0
    case "$options" in
        *"caps:"*) return 0 ;;
        "@as []" | "[]") options="['caps:ctrl_modifier']" ;;
        *) options="${options%]}, 'caps:ctrl_modifier']" ;;
    esac
    gsettings set "$key" xkb-options "$options"
    echo "Caps Lock remapped to Ctrl."
}

# xcape makes a tap of Caps Lock send Escape, while holding it is still Ctrl.
# X11 only: under Wayland it never sees the key. The binary comes from the
# Debian package, fetched without root, so it needs apt and runs only where
# its X libraries are installed.
XCAPE_BIN="$HOME/.local/bin/xcape"
XCAPE_AUTOSTART="$HOME/.config/autostart/xcape.desktop"

# Download xcape for this machine to $1
download_xcape() {
    command -v apt-get >/dev/null && command -v dpkg-deb >/dev/null || return 1
    local tmp status=0
    tmp=$(mktemp -d)
    (cd "$tmp" && apt-get download -q=2 xcape) \
        && dpkg-deb -x "$tmp"/xcape_*.deb "$tmp/root" \
        && bin_runs "$tmp/root/usr/bin/xcape" \
        && install -D -m 755 "$tmp/root/usr/bin/xcape" "$1" \
        || status=1
    rm -rf "$tmp"
    return "$status"
}

# Install or update xcape at $1. It rarely changes, so fetching the 11K
# package and comparing is simpler than tracking versions.
update_xcape() {
    local tmp
    tmp=$(mktemp -d)
    if download_xcape "$tmp/xcape"; then
        if ! cmp -s "$tmp/xcape" "$1"; then
            if [ -e "$1" ]; then echo "Updating xcape..."; else echo "Installing xcape..."; fi
            install -D -m 755 "$tmp/xcape" "$1"
        fi
    elif [ ! -e "$1" ]; then
        echo "Note: couldn't install xcape (needs apt and X11 libraries); skipping." >&2
    fi
    rm -rf "$tmp"
}

# Start xcape at login, when Caps Lock is Ctrl (set_caps_ctrl). Otherwise a
# tap would toggle Caps Lock as well as sending Escape. The session type is
# checked at each login, so switching between X11 and Wayland is fine.
set_caps_escape() {
    command -v gsettings >/dev/null || return 0
    case "$(gsettings get org.gnome.desktop.input-sources xkb-options 2>/dev/null)" in
        *"caps:ctrl_modifier"*) ;;
        *) return 0 ;;
    esac
    local xcape
    xcape=$(command -v xcape || true)
    if ! bin_runs "$xcape"; then
        xcape="$XCAPE_BIN"
        bin_runs "$xcape" || return 0
    fi
    mkdir -p "$(dirname "$XCAPE_AUTOSTART")"
    # Exec runs: sh -c '[ "$XDG_SESSION_TYPE" = x11 ] && exec xcape ...'
    # Desktop entries only quote with "", inside which " and $ take a \, and
    # the file format doubles every \. printf turns each \\ here into one \.
    {
        echo "[Desktop Entry]"
        echo "Type=Application"
        echo "Name=xcape"
        echo "Comment=Caps Lock sends Escape when tapped (X11 sessions only)"
        # shellcheck disable=SC2016 # $XDG_SESSION_TYPE is for sh at login
        printf 'Exec=sh -c "[ \\\\"\\\\$XDG_SESSION_TYPE\\\\" = x11 ] && exec %s -e Caps_Lock=Escape"\n' "$xcape"
        echo "X-GNOME-Autostart-enabled=true"
    } >"$XCAPE_AUTOSTART"
    # Start it now too, when bootstrapping from an X11 session
    if [ "${XDG_SESSION_TYPE:-}" = x11 ] && ! pgrep -x xcape >/dev/null; then
        "$xcape" -e Caps_Lock=Escape
    fi
    echo "xcape set up: tapping Caps Lock sends Escape in X11 sessions."
}

# Install binary $2 from an offline package as $3. The package wins over what's
# in ~/.local/bin, as it does for plugins and language servers, but a $1
# installed elsewhere (e.g. with apt) is left alone.
install_packaged_bin() {
    local name="$1" src="$2" dest="$3"
    [ -f "$src" ] || return 0
    if [ ! -e "$dest" ] && bin_runs "$name"; then
        return 0
    fi
    if ! bin_runs "$src"; then
        echo "Note: the packaged $name won't run on this machine; skipping it." >&2
        return 0
    fi
    cmp -s "$src" "$dest" && return 0
    if [ -e "$dest" ]; then echo "Updating $name..."; else echo "Installing $name..."; fi
    install -D -m 755 "$src" "$dest"
}

gitconfig_note() {
    if ! git config --file "$HOME/.gitconfig.local" user.name >/dev/null; then
        echo "Note: add your [user] name and email to ~/.gitconfig.local."
    fi
}

# .gitconfig uses diff3 conflict markers, which every git understands. zdiff3
# (git 2.35+) leaves out lines both sides share; older git rejects it, so it
# goes in the untracked ~/.gitconfig.local only where git supports it.
set_conflict_style() {
    local version
    version=$(git --version | sed -n 's/^git version \([0-9.]*\).*/\1/p')
    if [ "$(printf '%s\n%s\n' 2.35 "$version" | sort -V | head -1)" = 2.35 ]; then
        git config --file "$HOME/.gitconfig.local" merge.conflictStyle zdiff3
    else
        git config --file "$HOME/.gitconfig.local" --unset merge.conflictStyle || true
    fi
}

bootstrap_online() {
    if [ -d "$DOTFILES_DIR" ]; then
        checkout_dotfiles
        local old
        old=$(dotfiles rev-parse HEAD)
        update_dotfiles origin
        # Carry on with the updated version of this script, if it changed
        if [ -z "${DOTFILES_BOOTSTRAP_UPDATED:-}" ] \
            && ! dotfiles diff --quiet "$old" HEAD -- .local/bin/dotfiles-bootstrap; then
            echo "Continuing with the updated dotfiles-bootstrap..."
            DOTFILES_BOOTSTRAP_UPDATED=1 exec "$HOME/.local/bin/dotfiles-bootstrap"
        fi
    else
        clone_dotfiles "$DOTFILES_REPO"
        checkout_dotfiles
    fi

    if ! font_installed; then
        echo "Installing ${NERD_FONT} Nerd Font..."
        download_font "$FONT_DIR"
        fc-cache -f
    fi
    # Ours to update are the ones in ~/.local/bin; one installed elsewhere
    # (e.g. with apt) is left alone
    if [ -e "$DELTA_BIN" ] || ! bin_runs delta; then
        update_release delta "$DELTA_RELEASES" "$(delta_version "$DELTA_BIN")" download_delta "$DELTA_BIN"
    fi
    update_lsp_servers "$LSP_DIR"
    link_lsp_bins
    if [ -e "$XCAPE_BIN" ] || ! bin_runs xcape; then
        update_xcape "$XCAPE_BIN"
    fi
    set_terminal_font
    set_caps_ctrl
    set_caps_escape
    install_nvim_plugins
    set_conflict_style
    gitconfig_note
}

pack() {
    local out="${1:-$PWD/dotfiles-offline-$(uname -m)-$(date +%Y%m%d).tar.gz}"
    STAGE=$(mktemp -d)
    local root="$STAGE/dotfiles-offline"
    mkdir -p "$root"

    if [ -n "$(dotfiles status --porcelain)" ]; then
        echo "Warning: the dotfiles repo has uncommitted changes; only committed files are packed." >&2
    fi
    echo "Packing dotfiles repo..."
    dotfiles bundle create "$root/dotfiles.bundle" --all

    if [ -d "$NVIM_SITE" ]; then
        echo "Packing nvim plugins and treesitter parsers..."
        cp -a "$NVIM_SITE" "$root/nvim-site"
        fix_site_links "$root/nvim-site"
    else
        echo "Warning: $NVIM_SITE not found; start nvim once online to install plugins." >&2
    fi

    # Kept as the release .tar.xz: ~7M instead of ~230M unpacked
    echo "Packing ${NERD_FONT} Nerd Font..."
    if ! curl -fsSL "$FONT_URL" -o "$root/font.tar.xz"; then
        rm -f "$root/font.tar.xz"
        if has_font_files "$FONT_DIR"; then
            tar cJf "$root/font.tar.xz" -C "$FONT_DIR" .
        else
            echo "Warning: couldn't download the font and it isn't installed; skipping." >&2
        fi
    fi

    # The servers, delta and xcape start from the installed copies, which are
    # then updated or downloaded like an online install would
    echo "Packing language servers..."
    if [ -d "$LSP_DIR" ]; then
        cp -a "$LSP_DIR" "$root/lsp"
    fi
    update_lsp_servers "$root/lsp"

    echo "Packing delta..."
    if bin_runs "$DELTA_BIN"; then
        cp "$DELTA_BIN" "$root/delta"
    elif bin_runs delta; then
        cp "$(command -v delta)" "$root/delta"
    fi
    update_release delta "$DELTA_RELEASES" "$(delta_version "$root/delta")" download_delta "$root/delta"

    echo "Packing xcape..."
    if bin_runs "$XCAPE_BIN"; then
        cp "$XCAPE_BIN" "$root/xcape"
    elif bin_runs xcape; then
        cp "$(command -v xcape)" "$root/xcape"
    fi
    update_xcape "$root/xcape"

    cp -a "$(realpath "${BASH_SOURCE[0]}")" "$root/dotfiles-bootstrap"
    {
        echo "created: $(date -Iseconds)"
        echo "arch: $(uname -m)"
        echo "commit: $(dotfiles rev-parse --short HEAD)"
        command -v nvim >/dev/null && echo "nvim: $(nvim --version | head -1)"
    } >"$root/MANIFEST"

    tar czf "$out" -C "$STAGE" dotfiles-offline
    echo "Created $out ($(du -h "$out" | cut -f1))"
    echo "On the target machine: tar xzf $(basename "$out") && dotfiles-offline/dotfiles-bootstrap apply dotfiles-offline"
}

apply() {
    local src="${1:?Usage: dotfiles-bootstrap apply PATH}"
    local root
    if [ -d "$src" ]; then
        root="$src"
    else
        STAGE=$(mktemp -d)
        tar xzf "$src" -C "$STAGE"
        root="$STAGE/dotfiles-offline"
    fi
    [ -f "$root/MANIFEST" ] || { echo "Not an offline package: $src" >&2; exit 1; }
    # The dotfiles function runs git from $HOME
    root=$(realpath "$root")
    cat "$root/MANIFEST"

    # Parsers and fzf-native are compiled binaries
    local packed_arch
    packed_arch=$(sed -n 's/^arch: //p' "$root/MANIFEST")
    if [ "$packed_arch" != "$(uname -m)" ]; then
        echo "Warning: package was built on $packed_arch but this machine is $(uname -m);" \
            "compiled parsers and telescope-fzf-native won't run." >&2
    fi

    if [ -d "$DOTFILES_DIR" ]; then
        checkout_dotfiles
        update_dotfiles "$root/dotfiles.bundle"
    else
        clone_dotfiles "$root/dotfiles.bundle"
        # Pull/push from GitHub later, when there's internet
        dotfiles remote set-url origin "$DOTFILES_REPO"
        checkout_dotfiles
    fi

    if [ -d "$root/nvim-site" ]; then
        echo "Installing nvim plugins and treesitter parsers..."
        mkdir -p "$NVIM_SITE"
        # Replace each packaged plugin wholesale rather than merging two git checkouts
        local plugin
        for plugin in "$root/nvim-site/pack/core/opt"/*/; do
            rm -rf "$NVIM_SITE/pack/core/opt/$(basename "$plugin")"
        done
        # --remove-destination: git object files are read-only
        cp -a --remove-destination "$root/nvim-site/." "$NVIM_SITE/"
        # Also repairs packages made before pack fixed the links
        fix_site_links "$NVIM_SITE"
    fi

    if ! font_installed && [ -f "$root/font.tar.xz" ]; then
        echo "Installing ${NERD_FONT} Nerd Font..."
        mkdir -p "$FONT_DIR"
        tar xJf "$root/font.tar.xz" -C "$FONT_DIR"
        fc-cache -f
    fi
    install_packaged_bin delta "$root/delta" "$DELTA_BIN"

    if [ -d "$root/lsp" ]; then
        echo "Installing language servers..."
        mkdir -p "$LSP_DIR"
        # Replace each packaged server wholesale, like the nvim plugins
        local server
        for server in "$root/lsp"/*/; do
            rm -rf "${LSP_DIR:?}/$(basename "$server")"
        done
        cp -a "$root/lsp/." "$LSP_DIR/"
        if ! command -v node >/dev/null; then
            echo "Warning: node not found; the bash and JS/TS language servers need Node 22+." >&2
        fi
        if ! command -v pwsh >/dev/null; then
            echo "Warning: pwsh not found; the PowerShell language server needs it." >&2
        fi
    fi
    link_lsp_bins

    install_packaged_bin xcape "$root/xcape" "$XCAPE_BIN"
    set_terminal_font
    set_caps_ctrl
    set_caps_escape

    set_conflict_style
    gitconfig_note
}

main() {
    case "${1:-}" in
        "") bootstrap_online ;;
        pack) shift; pack "$@" ;;
        apply) shift; apply "$@" ;;
        -h | --help | help) usage ;;
        *) usage >&2; exit 1 ;;
    esac
}

# On one line, so bash has read all of it before an update can rewrite this file
main "$@"; exit
